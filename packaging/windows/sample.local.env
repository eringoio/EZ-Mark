# EZ Mark Mode A local desktop configuration.
# Keep HOST=127.0.0.1 for local-only use.
# Do not use 0.0.0.0 and do not expose this mode to the LAN.
# The launcher opens Chrome app mode at http://127.0.0.1:8000.

ENV=production
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=50

# DATABASE_URL and DATA_ROOT are set by the launcher from the folder containing EZMark.exe.
# Example only:
# DATABASE_URL=sqlite:///C:/EZMark/data/app.sqlite
# DATA_ROOT=C:/EZMark/data
